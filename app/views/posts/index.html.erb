<h2>予定一覧</h2>
<button><%= link_to "新規追加", :new_post %></button>
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>タイトル</th>
      <th>開始日</th>
      <th>終了日</th>
      <th>終日</th>
      <th>更新日時</th>
      <th></th>
      <th></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @posts.each do |post| %>
      <tr>
        <td><%= post.id %></td>
        <td><%= post.title %></td>
        <td><%= post.start_datetime %></td>
        <td><%= post.end_datetime %></td>
        <td><%= post.is_all_day ? "◯" : "" %></td>
        <td><%= post.updated_at.to_s(:datetime_jp) %></td>
        <td>
          <%= link_to "詳細", post %>
        </td>
        <td>
          <%= link_to "編集", edit_post_path(post) %>
        </td>
        <td>
          <%= link_to "削除", post, method: :delete, data: { confirm: "予定を削除しますか？" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= render "shared/footer" %>