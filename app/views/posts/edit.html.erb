<h3>予定を編集してください</h3>

<%= form_with model: @post do |f| %>
  <table>
    <tr>
      <th><%= f.label :title ,"タイトル" %></th>
      <td><%= f.text_field :title %></td>
      <div class="error"><% @post.errors.where(:title).each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </tr>

    <tr>
      <th><%= f.label :start_datetime ,"開始日" %></th>
      <td><%= f.date_field :start_datetime %></td>
      <div class="error"><% @post.errors.where(:start_datetime).each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </tr>

    <tr>
      <th><%= f.label :end_datetime ,"終了日" %></th>
      <td><%= f.date_field :end_datetime %></td>
      <div class="error"><% @post.errors.where(:end_datetime).each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </tr>

    <tr>
      <th><%= f.label :is_all_day ,"終日の場合はチェックを入れます" %></th>
      <td><%= f.check_box :is_all_day %></td>
    </tr>

    <tr>
      <th><%= f.label :memo ,"スケジュールメモ" %></th>
      <td><%= f.text_area :memo %></td>
    </tr>
  </table>

  <div>
      <button><%= link_to "キャンセル", :posts %></button>
      <button><%= f.submit "保存" %></button>
  </div>
<% end %>
